{
    "homepage": "https://pixpin.cn/",
    "description": "PixPin - Screenshot, annotation, long capture, OCR, and sticky image tool.",
    "version": "2.2.4.1",
    "license": "Freeware (proprietary)",
    "url": "https://download.pixpin.cn/PixPin_cn_zh-cn_2.2.4.1.zip",
    "hash": "cc5b983d135751ad591cdeba6ee5bea13171007fcacf4083dabb23bc17baaad8",
    "extract_dir": "PixPin",
    "shortcuts": [
        [
            "PixPin.exe",
            "PixPin"
        ]
    ],
    "persist": [
        "Config",
        "Data",
        "History"
    ],
    "checkver": {
        "script": [
            "$page = Invoke-WebRequest -UseBasicParsing -Uri 'https://pixpin.cn/download/'",
            "$link = $page.Links | Where-Object { $_.outerHTML -match '点此下载便携版|portable' -or $_.id -eq 'portable-download-link' } | Select-Object -First 1 -ExpandProperty href",
            "if (-not $link) { return 'unknown' }",
            "if ($link -notmatch '^https?://') { $link = 'https://pixpin.cn' + $link }",
            "if ($link -match '([\\d\\.]+)\\.zip$') {",
            "    $ver = $matches[1]",
            "    \"$ver|$link\"",
            "} else {",
            "    'unknown'",
            "}"
        ],
        "regex": "^(?<version>[\\d\\.]+)\\|(?<url>.+)$"
    },
    "autoupdate": {
        "url": "$matchUrl",
        "hash": {
            "mode": "download"
        }
    }
}
